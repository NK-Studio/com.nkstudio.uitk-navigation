.ge-node__color-line,
.ge-node-title-part,
.ge-port__label {
    display: none;
}

.ge-node .ge-port__icon {
    display: none;
}

.ge-node .ge-node__inputs .ge-port-hierarchy-container__container,
.ge-node .ge-node__outputs .ge-port-hierarchy-container__container {
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
}

.ge-node {
    min-width: 0;
    min-height: 0;
    width: auto;
    padding-top: 0;
    padding-bottom: 0;
    border-radius: 12px;
    background-color: rgb(56, 56, 56);
}

.ge-node__node-options {
    margin: 0;
    padding: 0;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
}

.ge-node__node-options .unity-base-field__label {
    display: none;
}

/* 회전은 UINavigationPivotViewStyler가 끼워 넣는 아이콘 버튼으로 합니다.
   드롭다운은 모델과 값을 주고받는 통로라 지우지 않고 숨기기만 합니다. */
.ge-node__node-options .unity-enum-field {
    display: none;
}

.pivot__rotate {
    width: 10px;
    height: 10px;
    align-self: center;
    flex-shrink: 0;
    margin: 6px 10px;
    border-radius: 3px;
}

.pivot__rotate:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.pivot--right .ge-port,
.pivot--left .ge-port {
    flex-shrink: 0;
}

.pivot--right .ge-node__port-container,
.pivot--left .ge-node__port-container,
.pivot--down .ge-node__port-container,
.pivot--up .ge-node__port-container {
    position: absolute;
    top: -1.333px;
    bottom: -1.333px;
    left: -1.333px;
    right: -1.333px;
    background-color: transparent;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
}

.pivot--right .ge-node__inputs,
.pivot--right .ge-node__outputs,
.pivot--left .ge-node__inputs,
.pivot--left .ge-node__outputs {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    min-width: 0;
    align-items: center;
}

.pivot--right .ge-node__inputs,
.pivot--left .ge-node__inputs,
.pivot--down .ge-node__inputs,
.pivot--up .ge-node__inputs {
    background-color: rgb(56, 56, 56);
}

.pivot--right .ge-node__inputs,
.pivot--left .ge-node__outputs {
    left: 0;
    right: auto;
}

.pivot--right .ge-node__outputs,
.pivot--left .ge-node__inputs {
    left: auto;
    right: 0;
}

.pivot--right .ge-node__outputs {
    padding-left: 0;
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
}

.pivot--left .ge-node__outputs {
    padding-left: 0;
    border-top-left-radius: 11px;
    border-bottom-left-radius: 11px;
}

/* GraphToolkit 포트의 방향별 내부 폭이 달라서, 커넥터 중심을 좌우 대칭 좌표로 직접 맞춥니다. */
.pivot--right .ge-node__inputs .ge-port {
    translate: 3px -1px;
}

.pivot--right .ge-node__outputs .ge-port {
    translate: -3.5px 01px;
}

.pivot--left .ge-node__inputs .ge-port {
    translate: -10px -1px;
}

.pivot--left .ge-node__outputs .ge-port {
    translate: 4px -1px;
}

/* Left는 포트 내부를 뒤집어 커넥터를 반대쪽 가장자리로 보냅니다. */
.pivot--left .ge-node__inputs .ge-port__connector-container {
    flex-direction: row-reverse;
}

.pivot--left .ge-node__outputs .ge-port__connector-container {
    flex-direction: row;
}

.pivot--left .ge-port__connector {
    rotate: 180deg;
}

/* 세로 상태도 포트 모델은 가로로 유지해야 와이어가 보존됩니다.
   입력/출력 영역을 노드의 정확한 위아래 절반에 겹칩니다. */
.pivot--down .ge-node__inputs,
.pivot--down .ge-node__outputs,
.pivot--up .ge-node__inputs,
.pivot--up .ge-node__outputs {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    align-items: center;
}

.pivot--down .ge-node__inputs,
.pivot--up .ge-node__outputs {
    top: 0;
    bottom: auto;
    height: 34px;
}

.pivot--down .ge-node__outputs,
.pivot--up .ge-node__inputs {
    top: auto;
    bottom: 0;
    height: 34px;
}

.pivot--down .ge-node__outputs {
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.pivot--up .ge-node__outputs {
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
}

/* 가로 포트의 입력/출력 내부 여백이 서로 다르므로 포트 뷰 전체를 보정해
   실제 커넥터 중심을 노드 위/아래 가장자리의 중앙에 맞춥니다. */
.pivot--down .ge-node__inputs .ge-port {
    translate: 3px -2px;
}

.pivot--down .ge-node__outputs .ge-port {
    translate: -12px 3px;
}

.pivot--up .ge-node__inputs .ge-port {
    translate: 3px 3px;
}

.pivot--up .ge-node__outputs .ge-port {
    translate: -12px -2px;
}

.pivot--right .pivot__rotate,
.pivot--down .pivot__rotate,
.pivot--left .pivot__rotate,
.pivot--up .pivot__rotate {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: 0;
    translate: -5px -5px;
}

/* 포트 행이 흐름에서 빠져도 버튼과 포트가 겹치거나 노드 폭이 무너지지 않게 자리를 확보합니다. */
.pivot--down .ge-node__node-options,
.pivot--up .ge-node__node-options {
    margin-top: 22px;
    margin-bottom: 22px;
    min-width: 72px;
}

.pivot--down .ge-port__connector {
    rotate: 90deg;
}

.pivot--up .ge-port__connector {
    rotate: 270deg;
}

.ge-node__cache {
    min-width: 0;
    min-height: 0;
    padding: 0;
}
