.uiback-inspector {
    padding: 4px 2px 6px 2px;
}

.uiback-inspector__hero {
    min-height: 58px;
    margin-bottom: 9px;
    padding: 10px 12px;
    flex-direction: row;
    align-items: center;
    background-color: var(--unity-colors-inspector_titlebar-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 7px;
}

.uiback-inspector__hero-icon {
    width: 36px;
    height: 36px;
    margin-right: 11px;
    color: rgb(140, 185, 255);
    background-color: rgba(61, 111, 184, 0.28);
    border-width: 1px;
    border-color: rgba(112, 163, 238, 0.55);
    border-radius: 7px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.uiback-inspector__hero-copy {
    flex-grow: 1;
    justify-content: center;
}

.uiback-inspector__hero-title {
    margin-bottom: 2px;
    color: var(--unity-colors-default-text);
    font-size: 15px;
    -unity-font-style: bold;
    overflow: hidden;
}

.uiback-inspector__hero-subtitle,
.uiback-inspector__card-description,
.uiback-inspector__hint {
    color: var(--unity-colors-label-text);
    font-size: 10px;
    overflow: hidden;
}

.uiback-inspector__card {
    margin-bottom: 8px;
    padding: 10px 11px;
    background-color: var(--unity-colors-default-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 7px;
}

.uiback-inspector__card-title {
    margin-bottom: 2px;
    color: var(--unity-colors-default-text);
    font-size: 12px;
    -unity-font-style: bold;
}

.uiback-inspector__card-description {
    margin-bottom: 8px;
}

.uiback-inspector__field {
    min-height: 20px;
    margin-left: 0;
    margin-right: 0;
}

.uiback-inspector__field > .unity-base-field__label {
    min-width: 145px;
}

.uiback-inspector__hint {
    margin-top: 5px;
    -unity-font-style: italic;
}
